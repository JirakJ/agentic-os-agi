{
  "name": "proto-forge-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "pnpm run config:check && pnpm run gates:selftest && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build && pnpm run budget && pnpm run i18n:verify && pnpm run layer:scan && pnpm run testid:scan && pnpm run docs:verify && pnpm run stub:scan && pnpm run adr:lint && pnpm run prompt:lint && pnpm run dup:scan && pnpm run consistency && pnpm run sec:scan && pnpm run snapshot:diff && pnpm run test:e2e",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "budget": "node scripts/budget.mjs",
    "i18n:verify": "node scripts/i18n-verify.mjs",
    "i18n:extract": "i18next 'src/**/*.{ts,tsx}' && node scripts/pseudo-gen.mjs",
    "layer:scan": "node scripts/layer-scan.mjs",
    "testid:scan": "node scripts/testid-scan.mjs",
    "docs:verify": "node scripts/docs-verify.mjs",
    "docs:shots": "node scripts/docs-shots.mjs",
    "config:show": "node scripts/config-cli.mjs show",
    "config:check": "node scripts/config-cli.mjs check",
    "gates:selftest": "node scripts/gates-selftest.mjs",
    "sync:jira": "node scripts/sync-jira.mjs",
    "sync:confluence": "node scripts/sync-confluence.mjs",
    "stub:scan": "node scripts/stub-scan.mjs",
    "adr:lint": "node scripts/adr-lint.mjs",
    "prompt:lint": "node scripts/prompt-log-lint.mjs",
    "dup:scan": "jscpd src packages/proto-ui/src --config .jscpd.json && node scripts/component-dup-scan.mjs",
    "consistency": "node scripts/consistency.mjs",
    "sec:scan": "node scripts/sec-scan.mjs && pnpm run sbom",
    "sbom": "node scripts/sbom.mjs",
    "snapshot": "node scripts/snapshot-diff.mjs --write",
    "seed:lock": "node scripts/snapshot-diff.mjs --write-seed",
    "snapshot:diff": "node scripts/snapshot-diff.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.21",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.13",
    "i18next": "^24.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.7.4",
    "react-router": "^8.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "i18next-parser": "^9.4.0",
    "jscpd": "^4.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
